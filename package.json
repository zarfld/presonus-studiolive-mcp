{
  "name": "presonus-studiolive-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for PreSonus StudioLive mixers — provides AI-agent context for show preparation, soundcheck diagnostics, and routing validation",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "check:agent-context": "tsx scripts/check-agent-context.ts",
    "clean": "pnpm -r exec rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hil": "cross-env HIL_PRESONUS=1 vitest run --config vitest.hil.config.ts",
    "test:coverage": "vitest run --coverage",
    "probe": "node packages/presonus-inspector/dist/cli/probe.js",
    "probe:dev": "tsx packages/presonus-inspector/src/cli/probe.ts",
    "mcp:server": "node packages/presonus-mcp-server/dist/index.js",
    "mcp:server:dev": "tsx packages/presonus-mcp-server/src/index.ts",
    "typecheck": "tsc --build --dry",
    "inventory": "tsx scripts/generate-capability-matrix.ts",
    "traceability": "node scripts/run-python-script.mjs scripts/github-issues-to-traceability-json.py",
    "check:privacy": "node scripts/check-sensitive-staged.mjs --all",
    "check:privacy:staged": "node scripts/check-sensitive-staged.mjs --staged",
    "test:privacy": "node --test test/check-sensitive.test.mjs",
    "install:hooks": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.8",
      "hono": "4.13.7",
      "@hono/node-server": "1.19.15",
      "qs": "6.16.0",
      "ip-address": "10.7.2",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^5": "5.0.9"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
